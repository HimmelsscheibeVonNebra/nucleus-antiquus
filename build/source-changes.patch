+                "negl %%eax\n"
+                "1:"
+                :"=a" (__res):"0" (0),"D" (cs),"S" (ct),"c" (count)
+                );
+        return __res;
+}
+
+inline void * memchr(const void * cs,char c,int count)
+{
+        register void * __res ;
+        if (!count)
+                return NULL;
+        __asm__("cld\n\t"
+                "repne\n\t"
+                "scasb\n\t"
+                "je 1f\n\t"
+                "movl $1,%0\n"
+                "1:\tdecl %0"
+                :"=D" (__res):"a" (c),"D" (cs),"c" (count)
+                );
+        return __res;
+}
+
+static inline void * memset(void * s,char c,int count)
+{
+        __asm__("cld\n\t"
+                "rep\n\t"
+                "stosb"
+                ::"a" (c),"D" (s),"c" (count)
+                );
+        return s;
