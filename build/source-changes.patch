+                "je 7f\n\t"
+                "movl %1,%0\n"
+                "3:\tlodsb\n\t"
+                "testb %%al,%%al\n\t"
+                "je 5f\n\t"
+                "movl %4,%%edi\n\t"
+                "movl %%edx,%%ecx\n\t"
+                "repne\n\t"
+                "scasb\n\t"
+                "jne 3b\n\t"
+                "decl %1\n\t"
+                "cmpb $0,(%1)\n\t"
+                "je 5f\n\t"
+                "movb $0,(%1)\n\t"
+                "incl %1\n\t"
+                "jmp 6f\n"
+                "5:\txorl %1,%1\n"
+                "6:\tcmpb $0,(%0)\n\t"
+                "jne 7f\n\t"
+                "xorl %0,%0\n"
+                "7:\ttestl %0,%0\n\t"
+                "jne 8f\n\t"
