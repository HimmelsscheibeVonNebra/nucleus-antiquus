+inline void * memcpy(void * dest,const void * src, int n)
+{
+        __asm__ ("cld\n\t"
+                 "rep\n\t"
+                 "movsb"
+                 ::"c" (n),"S" (src),"D" (dest)
+                );
+        return dest;
+}
+
+inline void * memmove(void * dest,const void * src, int n)
+{
+        if (dest<src)
+                __asm__("cld\n\t"
+                        "rep\n\t"
+                        "movsb"
+                        ::"c" (n),"S" (src),"D" (dest)
+                        );
+        else
+                __asm__("std\n\t"
+                        "rep\n\t"
+                        "movsb"
+                        ::"c" (n),"S" (src+n-1),"D" (dest+n-1)
+                        );
+        return dest;
+}
+
+static inline int memcmp(const void * cs,const void * ct,int count)
+{
+        register int __res ;
+        __asm__("cld\n\t"
+                "repe\n\t"
+                "cmpsb\n\t"
+                "je 1f\n\t"
